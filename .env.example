# Neon Serverless Postgres (Postgres connection string)
# For a pooled connection, use the pooled connection string from the Neon Console.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Express API port
PORT=3001

# Cookie session signing key. Use a long random string.
SESSION_SECRET=

# Google OAuth (Web application client).
# Local `npm run dev` can start without these, but sign-in stays disabled until both are set.
# Authorized redirect URI for local dev:
#   http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google accounts that may use the app.
ALLOWED_EMAILS=you@gmail.com,them@gmail.com

# Where Google should send the user after login, and where the SPA lives.
# Local defaults (used when unset in development):
#   GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
#   FRONTEND_URL=http://localhost:5173/lesson-tracker/
# Production (Render). Required for cookie CORS and post-login redirect.
GOOGLE_REDIRECT_URI=
FRONTEND_URL=

# CORS allow-list for browser requests (scheme+host only, comma-separated).
# Cookie sessions require a specific origin (no wildcard)
CORS_ORIGINS=

# (Optional) Override the Vite dev proxy target for `/api` and `/auth` when running locally.
VITE_DEV_API_URL=http://localhost:3001

# Frontend (Vite) API base.
# - Leave blank in dev so Vite's proxy forwards `/api/*` and `/auth/*` to the local Express server.
# - In GitHub Pages production builds, set this to your deployed Express API origin (e.g. Render).
VITE_API_BASE=
